# ─────────────────────────────────────────────────────────────────
# CropHub AI — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# --- Supabase -------------------------------------------------------
# Get from: supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OpenWeatherMap --------------------------------------------------
# Get a free key at: openweathermap.org/api
# Optional — app uses mock weather data if this is omitted.
OPENWEATHER_API_KEY=your-openweathermap-api-key

# --- Admin Authentication -------------------------------------------
# PIN required to access the APMC Admin Console.
# CHANGE THIS before any public/production deployment!
ADMIN_PIN=change-me-before-production

# Cryptographic secret used to sign Admin session tokens (generate a 32+ char random string)
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

